# ============================================================
# Makrion — Firebase Functions environment variables
#
# Copy this file to functions/.env (git-ignored) for local dev.
# For production, use Firebase Secret Manager:
#   firebase functions:secrets:set USDA_API_KEY
#   firebase functions:secrets:set FATSECRET_CLIENT_ID
#   firebase functions:secrets:set FATSECRET_CLIENT_SECRET
# ============================================================
# ----------------------------------------------------------
# OpenFoodFacts
# No API key required — but you MUST supply a proper User-Agent
# per OFF terms of service: https://wiki.openfoodfacts.org/API
# ----------------------------------------------------------
OFF_USER_AGENT=Makrion/1.0 (contact@yourapp.com)
# ----------------------------------------------------------
# USDA FoodData Central
# Get a free API key at: https://fdc.nal.usda.gov/api-key-signup.html
# Without a key, DEMO_KEY works but has low rate limits.
# ----------------------------------------------------------
USDA_API_KEY=DEMO_KEY
# ----------------------------------------------------------
# FatSecret Platform API v4
# Register at: https://platform.fatsecret.com/
# Uses OAuth 2.0 client credentials flow.
# ----------------------------------------------------------
FATSECRET_CLIENT_ID=your_client_id_here
FATSECRET_CLIENT_SECRET=your_client_secret_here
# ----------------------------------------------------------
# CORS — comma-separated list of allowed origins
# ----------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000